    "next": "15.2.4",
    "react": "^19.0.0",
    "react-cookie": "^8.0.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-intersection-observer": "^9.16.0",
    "react-lottie-player": "^2.1.0",
    "sass": "^1.86.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/js-cookie": "^3.0.6",
